# 星域需求雷达与成交智能体 — 环境变量示例
# 复制为 .env 或 .env.local 后填写真实值。切勿把密钥提交到 Git。

# SQLite（本地 Demo，开箱即用）
DATABASE_URL="file:./dev.db"

# 生产环境请改为 PostgreSQL，例如：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/starfield?sslmode=require"

# Apollo.io People Search（仅服务端使用，禁止下发到浏览器）
APOLLO_API_KEY=

# Vercel AI Gateway / 兼容 OpenAI 的大模型接口
AI_GATEWAY_API_KEY=
AI_MODEL="openai/gpt-4.1-mini"
# 如不使用 Gateway，也可配置 OpenAI 兼容端点：
# OPENAI_API_KEY=
# OPENAI_BASE_URL="https://api.openai.com/v1"

# 企查查（预留，未配置时数据源显示「未接入」）
QCC_APP_KEY=
QCC_SECRET_KEY=

# 可选：扫描接口每分钟请求上限（默认 8）
SCAN_RATE_LIMIT_PER_MINUTE=8
# 单次扫描最多生成的信号数量（默认 20）
SCAN_MAX_SIGNALS=20
